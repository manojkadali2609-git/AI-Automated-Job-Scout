            "module": "anthropic-claude:simpleTextPrompt",
            "version": 1,
            "parameters": {},
            "mapper": {
                "model": "claude-haiku-4-5",
                "max_tokens": "1000",
                "textPrompt": "Act as my automated career scout. Today is September 30, 2026. Look at all the raw text data fed into you from the connected HTTP web crawlers. Filter through this data to extract active job openings, internships, or graduate apprentice roles in India that match this profile:\n- Degree: B.Tech in Automobile Engineering (Allied to Mechanical)\n- Target: DRDO, ISRO, ARAI, Tata Motors, Mahindra, PSUs, EV startups\n\nData from Portal 1: {{73.text}}\nData from Portal 2: {{73.text}}\nData from Portal 3: {{73.text}}\n\nPick the top 3 most relevant updates. Format your response into a short, clean, bulleted message optimized for a mobile screen. For each entry, provide: the Company/Lab Name, Role Title, Brief Eligibility, and the exact Direct Application Link/URL found in the text data. If no new updates are found today, reply with: 'No new automobile job updates found this morning.'\n"
            },
            "metadata": {
                "designer": {
                    "x": 1119,
                    "y": -151
                },
                "setupValidation": {
                    "result": {
                        "valid": true,
                        "fields": []
                    },
                    "version": 1,
                    "configuration": "9b6a4caab3cf5204"
                },
                "restore": {
                    "expect": {
                        "model": {
                            "label": "Claude Haiku 4.5The quickest option, perfect for simple questions and instant, straightforward answers"
                        }
                    }
                },
                "expect": [
                    {
                        "name": "model",
                        "type": "select",
                        "label": "Model",
                        "required": true,
                        "validate": {
                            "enum": [
                                "claude-haiku-4-5",
                                "claude-sonnet-5-5",
                                "claude-opus-5-5",
                                "claude-fable-5-1",
                                "claude-opus-5",
                                "claude-fable-5",
                                "claude-sonnet-5",
                                "claude-opus-4-8",
                                "claude-opus-4-7",
                                "claude-sonnet-4-6",
                                "claude-opus-4-6",
                                "claude-sonnet-4-5",
                                "claude-opus-4-5"
                            ]
                        }
